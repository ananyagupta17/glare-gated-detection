# Datasets (390 MB, re-downloadable via datasets/kitti/kitti.yaml)
datasets/

# Regenerable image data — labels/ and subset_ids.txt ARE committed (team contract, §10)
# (glob the contents, not the dir — git can't re-include a file inside an excluded dir)
data/clean/*
data/glared/*
data/restored/*
!data/clean/.gitkeep
!data/glared/.gitkeep
# full-val scale-up (--full): 340 MB of glared PNGs, regenerable from seed 42
data/clean_full/
data/glared_full/

# Model weights and run artifacts — never in Git (shared separately or regenerable)
models/
runs/
/*.pt
archive/

# Restoration outputs and local model dependencies
results/restoration_demo/
results/restoration_samples/**/*.png
external/Flare7K/

# Review/report artifacts are local deliverables, not source code
outputs/
.report-build/
.review2-build/
.chart-data-*/

# Results — keep the directory, ignore bulky per-run dumps
results/**/predictions/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# macOS
.DS_Store

# Local-only project context (untracked on purpose)
CLAUDE.md
