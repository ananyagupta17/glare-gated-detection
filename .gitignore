# Datasets (390 MB, re-downloadable via datasets/kitti/kitti.yaml)
datasets/

# Regenerable image data — labels/ and subset_ids.txt ARE committed (team contract, §10)
# (glob the contents, not the dir — git can't re-include a file inside an excluded dir)
data/clean/*
data/glared/*
data/restored/*
!data/clean/.gitkeep
!data/glared/.gitkeep
# full-val scale-up (--full): 340 MB of glared PNGs, regenerable from seed 42
data/clean_full/
data/glared_full/
# v2 paired synthesis (train + val, clean + glared JPEGs), regenerable from seed 42
data/v2/

# Model weights — ignore checkpoints, track final baseline
runs/**/*.pt
!models/yolo_baseline.pt

# Results — keep the directory, ignore bulky per-run dumps
results/**/predictions/

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# macOS
.DS_Store


